<?xml version='1.0'?>

<robot name="QCar" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find qcar_updated)/urdf/materials.xacro" />

    <link name="base">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <mesh filename="file://$(find qcar_navigation)/meshes/QCar2Body.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
            <material name="white" />
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <mesh filename="file://$(find qcar_navigation)/meshes/QCar2Body.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <mass value="2.4" />
            <inertia ixx="0.009543" ixy="0" ixz="0" iyy="0.038083" iyz="0" izz="0.038274" />
        </inertial>
    </link>
    <joint name="body_lidar_joint" type="fixed">
        <parent link="base"/>
        <child link="lidar"/>
        <origin rpy="0 0 0" xyz="-0.01227 -0.00045 0.16152"/>
        <axis xyz="0 0 1"/>
    </joint>
    <link name="lidar">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <mesh filename="file://$(find qcar_navigation)/meshes/QCar2Lidar.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
            <material name="blue" />
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <mesh filename="file://$(find qcar_navigation)/meshes/QCar2Lidar.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <mass value="0.15" />
            <inertia ixx="0.0000724" ixy="0" ixz="0" iyy="0.0000724" iyz="0" izz="0.000133" />
        </inertial>
    </link>
    <joint name="base_hubfl_joint" type="revolute">
        <parent link="base" />
        <child link="hubfl" />
        <origin rpy="0 0 0" xyz="0.12960 0.05590 0.03338" />
        <axis xyz="0 0 1" />
        <dynamics damping="0.143" friction="0.0" />
        <limit lower="-0.5236" upper="0.5236" effort="300" velocity="2" />
    </joint>
    <link name="hubfl">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <mesh filename="file://$(find qcar_navigation)/meshes/QCarSteeringHubL.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
            <material name="orange" />
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <mesh filename="file://$(find qcar_navigation)/meshes/QCarSteeringHubL.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <mass value="0.05" />
            <inertia ixx="0.00000925" ixy="0" ixz="0" iyy="0.0000131" iyz="0" izz="0.00000843" />
        </inertial>
    </link>
    <joint name="base_hubfr_joint" type="revolute">
        <parent link="base" />
        <child link="hubfr" />
        <origin rpy="0 0 0" xyz="0.12960 -0.05590 0.03338" />
        <axis xyz="0 0 1" />
        <limit lower="-0.5236" upper="0.5236" effort="300" velocity="2" />
        <dynamics damping="0.143" friction="0.0" />
    </joint>
    <link name="hubfr">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <mesh filename="file://$(find qcar_navigation)/meshes/QCarSteeringHubR.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
            <material name="orange" />
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <mesh filename="file://$(find qcar_navigation)/meshes/QCarSteeringHubR.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <mass value="0.05" />
            <inertia ixx="0.00000925" ixy="0" ixz="0" iyy="0.0000131" iyz="0" izz="0.00000843" />
        </inertial>
    </link>
    <joint name="hubfl_wheelfl_joint" type="continuous">
        <parent link="hubfl" />
        <child link="wheelfl" />
        <origin rpy="0 0 3.14" xyz="0 0 0" />
        <!-- axis negated to compensate for the 180deg yaw above (mesh mirror) -
             without this the left wheel spins opposite the right wheel -->
        <axis xyz="0 -1 0" />
    </joint>
    <link name="wheelfl">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <mesh filename="file://$(find qcar_navigation)/meshes/QCarWheel.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
            <material name="red" />
        </visual>
        <collision>
            <!-- gazebo_ros_ackermann_drive auto-computes wheel radius from the
                 collision shape but only supports cylinder/sphere primitives -
                 an STL mesh collision here makes it silently use radius 0,
                 which divides target_linear by zero and the car never drives.
                 Use a cylinder sized to the wheel mesh (radius 0.033m) instead,
                 keeping the STL for the visual only. -->
            <origin rpy="1.5708 0 0" xyz="0 0 0" />
            <geometry>
                <cylinder radius="0.036" length="0.0245" />
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <mass value="0.2" />
            <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0022" iyz="0" izz="0.0012" />
        </inertial>
    </link>
    <joint name="hubfr_wheelfr_joint" type="continuous">
        <parent link="hubfr" />
        <child link="wheelfr" />
        <origin rpy="0 0 0" xyz="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>
    <link name="wheelfr">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <mesh filename="file://$(find qcar_navigation)/meshes/QCarWheel.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
            <material name="orange" />
        </visual>
        <collision>
            <!-- gazebo_ros_ackermann_drive auto-computes wheel radius from the
                 collision shape but only supports cylinder/sphere primitives -
                 an STL mesh collision here makes it silently use radius 0,
                 which divides target_linear by zero and the car never drives.
                 Use a cylinder sized to the wheel mesh (radius 0.033m) instead,
                 keeping the STL for the visual only. -->
            <origin rpy="1.5708 0 0" xyz="0 0 0" />
            <geometry>
                <cylinder radius="0.036" length="0.0245" />
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <mass value="0.2" />
            <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0022" iyz="0" izz="0.0012" />
        </inertial>
    </link>

    <joint name="base_wheelrl_joint" type="continuous">
        <parent link="base" />
        <child link="wheelrl" />
        <origin rpy="0 0 3.14" xyz="-0.12765 0.05610 0.03338" />
        <!-- axis negated to compensate for the 180deg yaw above (mesh mirror) -
             without this the left wheel spins opposite the right wheel for the
             same signed velocity command -->
        <axis xyz="0 -1 0" />
    </joint>
    <link name="wheelrl">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <mesh filename="file://$(find qcar_navigation)/meshes/QCarWheel.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
            <material name="orange" />
        </visual>
        <collision>
            <!-- gazebo_ros_ackermann_drive auto-computes wheel radius from the
                 collision shape but only supports cylinder/sphere primitives -
                 an STL mesh collision here makes it silently use radius 0,
                 which divides target_linear by zero and the car never drives.
                 Use a cylinder sized to the wheel mesh (radius 0.033m) instead,
                 keeping the STL for the visual only. -->
            <origin rpy="1.5708 0 0" xyz="0 0 0" />
            <geometry>
                <cylinder radius="0.036" length="0.0245" />
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <mass value="0.2" />
            <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0022" iyz="0" izz="0.0012" />
        </inertial>
    </link>

    <joint name="base_wheelrr_joint" type="continuous">
        <parent link="base" />
        <child link="wheelrr" />
        <origin rpy="0 0 0" xyz="-0.12765 -0.05610 0.03338" />
        <axis xyz="0 1 0" />
    </joint>
    <link name="wheelrr">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <mesh filename="file://$(find qcar_navigation)/meshes/QCarWheel.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
            <material name="red" />
        </visual>
        <collision>
            <!-- gazebo_ros_ackermann_drive auto-computes wheel radius from the
                 collision shape but only supports cylinder/sphere primitives -
                 an STL mesh collision here makes it silently use radius 0,
                 which divides target_linear by zero and the car never drives.
                 Use a cylinder sized to the wheel mesh (radius 0.033m) instead,
                 keeping the STL for the visual only. -->
            <origin rpy="1.5708 0 0" xyz="0 0 0" />
            <geometry>
                <cylinder radius="0.036" length="0.0245" />
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <mass value="0.2" />
            <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0022" iyz="0" izz="0.0012" />
        </inertial>
    </link>

    <joint name="camera_rgb_joint" type="fixed">
        <!-- <axis xyz="0 1 0" /> -->
        <!-- <origin xyz=".2 0 0" rpy="0 0 0"/> -->
        <origin rpy="0 0 0" xyz="0.081686 0 0.15445" />
        <!-- <origin rpy="0 0 0" xyz="0 0 0"/> -->
        <parent link="base" />
        <child link="camera_rgb" />
    </joint>
    <link name="camera_rgb" />

    <joint name="camera_csi_front_joint" type="fixed">
        <!-- <axis xyz="0 1 0" /> -->
        <!-- <origin xyz=".2 0 0" rpy="0 0 0"/> -->
        <origin rpy="0 0 0" xyz="0.19236 -0.000475 0.093029" />
        <!-- <origin rpy="0 0 0" xyz="0 0 0"/> -->
        <parent link="base" />
        <child link="camera_csi_front" />
    </joint>
    <link name="camera_csi_front" />

    <joint name="camera_csi_right_joint" type="fixed">
        <!-- <axis xyz="0 1 0" /> -->
        <!-- <origin xyz=".2 0 0" rpy="0 0 0"/> -->
        <origin rpy="0 0 -1.5708" xyz="0.12887 -0.06755 0.093029" />
        <!-- <origin rpy="0 0 0" xyz="0 0 0"/> -->
        <parent link="base" />
        <child link="camera_csi_right" />
    </joint>
    <link name="camera_csi_right" />

    <joint name="camera_csi_back_joint" type="fixed">
        <!-- <axis xyz="0 1 0" /> -->
        <!-- <origin xyz=".2 0 0" rpy="0 0 0"/> -->
        <origin rpy="0 0 -3.1416" xyz="-0.16669 -0.000578 0.093029" />
        <!-- <origin rpy="0 0 0" xyz="0 0 0"/> -->
        <parent link="base" />
        <child link="camera_csi_back" />
    </joint>
    <link name="camera_csi_back" />

    <joint name="camera_csi_left_joint" type="fixed">
        <!-- <axis xyz="0 1 0" /> -->
        <!-- <origin xyz=".2 0 0" rpy="0 0 0"/> -->
        <origin rpy="0 0 1.5708" xyz="0.12784 0.052497 0.093029" />
        <!-- <origin rpy="0 0 0" xyz="0 0 0"/> -->
        <parent link="base" />
        <child link="camera_csi_left" />
    </joint>
    <link name="camera_csi_left" />

    <!-- Explicit high friction for the drive/steer wheels - without this the
         ackermann plugin can spin the wheel joints at exactly the commanded
         angular velocity (confirmed via debug logging) while the chassis
         never actually translates, since URDF collisions get no friction
         surface unless one is set here. -->
    <gazebo reference="wheelfl">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="wheelfr">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="wheelrl">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="wheelrr">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="camera_csi_front">
        <sensor type="camera" name="front_camera">
            <update_rate>30.0</update_rate>
            <camera name="head">
                <horizontal_fov>2</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <cameraName>qcar/csi_front</cameraName>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo>
        <plugin name="gazebo_ros_ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">
            <update_rate>100.0</update_rate>

            <!-- front wheel spin joints (child of the steering hubs) -->
            <front_left_joint>hubfl_wheelfl_joint</front_left_joint>
            <front_right_joint>hubfr_wheelfr_joint</front_right_joint>
            <!-- rear drive wheel joints -->
            <rear_left_joint>base_wheelrl_joint</rear_left_joint>
            <rear_right_joint>base_wheelrr_joint</rear_right_joint>
            <!-- front hub steering (yaw) joints -->
            <left_steering_joint>base_hubfl_joint</left_steering_joint>
            <right_steering_joint>base_hubfr_joint</right_steering_joint>

            <!-- wheelbase/track/wheel radius are auto-computed by the plugin
                 from the joints' actual poses/collision geometry in this URDF -->

            <!-- Real QCar steering limit: 30 deg -->
            <max_steer>0.5236</max_steer>
            <max_speed>20</max_speed>

            <!-- PID tuning: this vehicle's wheel/steering-hub rotational inertia is tiny
                 relative to a 100Hz control loop, so this is a genuinely stiff system -
                 even modest P gains here can diverge (confirmed: wheel joint velocity
                 goes NaN within ~1s at gain 1.0, and the resulting Ogre bounding-box
                 assertion kills gzserver). These low gains are stability-verified and
                 reach the commanded wheel speed within ~1s; retune upward with care and
                 always verify gzserver survives a sustained forward command before
                 trusting a new value. -->
            <left_steering_pid_gain>0.02 0 0.002</left_steering_pid_gain>
            <left_steering_i_range>0 0</left_steering_i_range>
            <right_steering_pid_gain>0.02 0 0.002</right_steering_pid_gain>
            <right_steering_i_range>0 0</right_steering_i_range>
            <linear_velocity_pid_gain>0.3 0 0.005</linear_velocity_pid_gain>
            <linear_velocity_i_range>0 0</linear_velocity_i_range>

            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>
            <publish_distance>false</publish_distance>

            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base</robot_base_frame>
        </plugin>
    </gazebo>

    <!-- LiDAR Sensor -->
    <gazebo reference="lidar">
        <sensor type="ray" name="lidar_sensor">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=/scan</remapping>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>lidar</frame_name>
            </plugin>
        </sensor>
    </gazebo>


  </robot>
